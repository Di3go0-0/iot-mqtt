    {
        "id": "eb411f15b3885666",
        "type": "function",
        "z": "0e7783ca91784c3e",
        "name": "mapper temp",
        "func": "// Extraemos los valores del objeto original\nlet temp = msg.payload.temp;\nlet hum = msg.payload.hum;\n\n// 1. Para las gráficas:\n// Creamos una propiedad extra para no sobreescribir el payload\nmsg.tempValue = temp;\nmsg.humValue = hum;\n\n// 2. Para Postgres:\n// Pasamos ambos valores en el array de parámetros\nmsg.params = [\n    String(temp),\n    String(hum)\n];\n\nmsg.query = \"INSERT INTO public.temp_hum (temp, hum) VALUES ($1, $2);\"\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
