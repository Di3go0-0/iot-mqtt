        "id": "7fa4a430bd60ba9a",
        "type": "function",
        "z": "0e7783ca91784c3e",
        "name": "Mapper",
        "func": "// Este nodo específico busca los parámetros en msg.params\nmsg.params = [\n    msg.payload.user,\n    msg.payload.state.toString()\n];\n\nmsg.query = \"INSERT INTO logs (user_name, action) VALUES ($1, $2);\";\n\nreturn msg;",
